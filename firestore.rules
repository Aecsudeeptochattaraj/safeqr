rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Global Safety Net - Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // HELPER PRIMITIVES
    function isSignedIn() { return request.auth != null; }
    function isVerified() { return isSignedIn() && (request.auth.token.email_verified == true || request.auth.token.firebase.sign_in_provider == 'google.com'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\+\\=]+$'); }

    // ROLE CHECKS (Sources of Truth)
    function isAdmin() { 
      return isSignedIn() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'super-admin']; 
    }
    function isPartner() { 
      return isSignedIn() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'partner'; 
    }

    // --------------------------------------------------
    // VALIDATION HELPERS
    // --------------------------------------------------

    function isValidUser(data) {
      return data.keys().hasAll(['email', 'role', 'displayName']) &&
             data.email is string && data.email.size() <= 100 &&
             data.role in ['user', 'partner', 'admin', 'super-admin', 'viewer'] &&
             data.displayName is string && data.displayName.size() <= 100;
    }

    function isValidVehicle(data) {
      return data.keys().hasAll(['vehicleNumber', 'ownerName', 'phone', 'status', 'createdAt']) &&
             data.vehicleNumber is string && data.vehicleNumber.size() <= 64 &&
             data.ownerName is string && data.ownerName.size() <= 128 &&
             data.phone is string && data.phone.size() <= 20 &&
             data.status in ['pending_verification', 'active', 'payment_rejected', 'expired'] &&
             (data.createdAt == request.time || data.createdAt is timestamp);
    }

    function isValidFeedback(data) {
       return data.keys().hasAll(['message', 'type', 'rating', 'createdAt', 'status']) &&
              data.message is string && data.message.size() <= 2000 &&
              data.type in ['general', 'bug', 'suggestion', 'scan_issue'] &&
              data.rating is number && data.rating >= 1 && data.rating <= 5 &&
              data.status in ['new', 'read', 'resolved'];
    }

    // --------------------------------------------------
    // COLLECTION: USERS
    // --------------------------------------------------
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isAdmin(); 
      allow create: if isSignedIn() && isOwner(userId) && isValidUser(incoming());
      allow update: if isAdmin() || (isSignedIn() && isOwner(userId) && 
                    (incoming().role == existing().role && incoming().email == existing().email));
      allow delete: if isAdmin();
    }

    // --------------------------------------------------
    // COLLECTION: FEEDBACK
    // --------------------------------------------------
    match /feedback/{feedbackId} {
      allow create: if true; 
      allow read, list: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // --------------------------------------------------
    // COLLECTION: QR_INVENTORY
    // --------------------------------------------------
    match /qr_inventory/{qrId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isAdmin() || (isVerified() && isPartner() && existing().partnerUid == request.auth.uid);
      allow delete: if isAdmin();
    }

    // --------------------------------------------------
    // COLLECTION: VEHICLES
    // --------------------------------------------------
    match /vehicles/{vehicleId} {
      allow get: if (resource.data.status == 'active') || 
                (isSignedIn() && (resource.data.ownerUid == request.auth.uid || resource.data.partnerUid == request.auth.uid || isAdmin()));
      allow list: if isSignedIn(); 
      allow create: if isSignedIn() && isValidVehicle(incoming());
      allow update: if isAdmin() || (isSignedIn() && (existing().ownerUid == request.auth.uid || existing().partnerUid == request.auth.uid));
      allow delete: if isAdmin();
    }

    // --------------------------------------------------
    // COLLECTION: PAYMENTS
    // --------------------------------------------------
    match /payments/{paymentId} {
      allow get: if isSignedIn() && (isOwner(existing().userId) || isAdmin() || isPartner());
      allow list: if isSignedIn() && (isAdmin() || isPartner() || isOwner(resource.data.userId));
      allow create: if isSignedIn();
      allow update: if isAdmin(); 
      allow delete: if isAdmin();
    }

    // --------------------------------------------------
    // COLLECTION: LOGS
    // --------------------------------------------------
    match /logs/{logId} {
      allow create: if true; 
      allow read, list: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // --------------------------------------------------
    // COLLECTION: COMMISSIONS
    // --------------------------------------------------
    match /commissions/{commissionId} {
      allow read, list: if isAdmin() || (isSignedIn() && resource.data.partnerUid == request.auth.uid);
      allow create: if isAdmin() || isPartner(); 
      allow update, delete: if isAdmin();
    }
  }
}
