rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Global Safety Net - Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // HELPER PRIMITIVES
    function isSignedIn() { return request.auth != null; }
    function isVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\+\\=]+$'); }

    // ROLE CHECKS (Sources of Truth - requires DB read)
    function isAdmin() { 
      return isSignedIn() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'super-admin']; 
    }
    function isPartner() { 
      return isSignedIn() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'partner'; 
    }

    // --------------------------------------------------
    // VALIDATION HELPERS
    // --------------------------------------------------

    function isValidUser(data) {
      return data.keys().hasAll(['email', 'role', 'displayName']) &&
             data.email is string && data.email.size() <= 100 &&
             data.role in ['user', 'partner', 'admin'] &&
             data.displayName is string && data.displayName.size() <= 100;
    }

    function isValidVehicle(data) {
      return data.keys().hasAll(['vehicleNumber', 'ownerName', 'phone', 'status', 'createdAt']) &&
             data.vehicleNumber is string && data.vehicleNumber.size() <= 64 &&
             data.ownerName is string && data.ownerName.size() <= 128 &&
             data.phone is string && data.phone.size() <= 20 &&
             data.status in ['pending_verification', 'active', 'payment_rejected', 'expired'] &&
             data.createdAt == request.time;
    }

    function isValidPayment(data) {
      return data.keys().hasAll(['transactionId', 'amount', 'userId', 'status', 'createdAt']) &&
             data.transactionId is string && data.transactionId.size() <= 128 &&
             data.amount is number && data.amount > 0 &&
             data.status in ['pending', 'verified', 'rejected'] &&
             data.createdAt == request.time;
    }

    // --------------------------------------------------
    // COLLECTION: USERS
    // --------------------------------------------------
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isAdmin(); 
      allow create: if isSignedIn() && isOwner(userId) && isValidUser(incoming());
      allow update: if (isAdmin() || (isSignedIn() && isOwner(userId))) && 
                    // Protect immutable fields and roles
                    (isAdmin() || (incoming().role == existing().role && incoming().email == existing().email));
      allow delete: if isAdmin();
    }

    // --------------------------------------------------
    // COLLECTION: QR_INVENTORY
    // --------------------------------------------------
    match /qr_inventory/{qrId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if (isVerified() && (
        isAdmin() || 
        // Partner can update status to 'assigned' or 'active' for their own stock
        (isPartner() && existing().partnerUid == request.auth.uid && (
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'mappedVehicleId', 'updatedAt'])
        ))
      ));
      allow delete: if isAdmin();
    }

    // --------------------------------------------------
    // COLLECTION: VEHICLES
    // --------------------------------------------------
    match /vehicles/{vehicleId} {
      allow get: if (resource.data.status == 'active') || 
                (isSignedIn() && (resource.data.ownerUid == request.auth.uid || resource.data.partnerUid == request.auth.uid || isAdmin()));
      allow list: if isSignedIn() && (
        isAdmin() || 
        resource.data.ownerUid == request.auth.uid || 
        resource.data.partnerUid == request.auth.uid
      );
      allow create: if isSignedIn() && 
                    isValidId(vehicleId) &&
                    isValidVehicle(incoming()) && (
                      isPartner() || 
                      incoming().ownerUid == request.auth.uid
                    );
      allow update: if (
        isAdmin() ||
        (isVerified() && (existing().ownerUid == request.auth.uid || existing().partnerUid == request.auth.uid) && (
           incoming().ownerUid == existing().ownerUid &&
           incoming().partnerUid == existing().partnerUid &&
           incoming().diff(existing()).affectedKeys().hasOnly(['phone', 'whatsapp', 'emergencyContact', 'updatedAt', 'status', 'qrId'])
        ))
      );
      allow delete: if isAdmin();
    }

    // --------------------------------------------------
    // COLLECTION: PAYMENTS
    // --------------------------------------------------
    match /payments/{paymentId} {
      allow get: if isSignedIn() && (isOwner(existing().userId) || isAdmin() || isPartner());
      allow list: if isSignedIn() && (isAdmin() || isPartner() || isOwner(resource.data.userId));
      allow create: if isSignedIn() && 
                    isValidId(paymentId) &&
                    isValidPayment(incoming()) && (
                      incoming().userId == request.auth.uid || isPartner()
                    ) &&
                    paymentId == incoming().transactionId;
      allow update: if isAdmin(); 
      allow delete: if isAdmin();
    }

    // --------------------------------------------------
    // COLLECTION: COMMISSIONS
    // --------------------------------------------------
    match /commissions/{commissionId} {
      allow get: if isSignedIn() && (isOwner(existing().partnerUid) || isAdmin());
      allow list: if isSignedIn() && (isOwner(resource.data.partnerUid) || isAdmin());
      allow create: if isVerified() && isPartner(); 
      allow update: if isAdmin(); 
      allow delete: if isAdmin();
    }

    // --------------------------------------------------
    // COLLECTION: LOGS
    // --------------------------------------------------
    match /logs/{logId} {
      allow create: if true; 
      allow read, list: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
